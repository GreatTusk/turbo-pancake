[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="Traps"
2d_physics/layer_2="Player"
2d_physics/layer_3="Platforms"
2d_physics/layer_4="One-way Platforms"
