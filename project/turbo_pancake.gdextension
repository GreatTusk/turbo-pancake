[configuration]

entry_symbol = "extension_library_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]

windows.debug.x86_64 = "res://bin/turbo_pancake.windows.64.debug.dll"
windows.release.x86_64 = "res://bin/turbo_pancake.windows.64.release.dll"
linux.debug.x86_64 = "res://bin/libturbo_pancake.linux.64.debug.so"
linux.release.x86_64 = "res://bin/libturbo_pancake.linux.64.release.so"
macos.debug = "res://bin/libturbo_pancake.darwin.64.debug.dylib"
macos.release = "res://bin/libturbo_pancake.darwin.64.release.dylib"
android.debug.x86_64 = "res://bin/libturbo_pancake.android.template_debug.x86_64.so"
android.release.x86_64 = "res://bin/libturbo_pancake.android.template_release.x86_64.so"
android.debug.arm64 = "res://bin/libturbo_pancake.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libturbo_pancake.android.template_release.arm64.so"